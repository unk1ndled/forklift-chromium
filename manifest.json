{
  "manifest_version": 3,
  "name": "Forklift",
  "version": "1.0",
  "description": "Bypass Pitchfork paywall on album review pages",
  "content_scripts": [
    {
      "matches": ["*://pitchfork.com/reviews/albums/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
}